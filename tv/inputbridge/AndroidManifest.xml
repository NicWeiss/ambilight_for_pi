<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.franko.inputbridge">

    <application
        android:allowBackup="false"
        android:label="Input Bridge"
        android:theme="@android:style/Theme.Translucent.NoTitleBar">

        <!-- Принимает запросы лаунчеров "открыть HDMI/AV" и переводит их в родной запрос этого ТВ -->
        <activity
            android:name=".BridgeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:host="android.media.tv" android:pathPrefix="/passthrough" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.xiaomi.mitv.tvplayer.EXTSRC_PLAY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Необязательно: кнопка INPUT -> меню источников в любом лаунчере. Включается вручную в настройках -->
        <service
            android:name=".KeyService"
            android:exported="true"
            android:label="Input Bridge: кнопка INPUT"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/key_service" />
        </service>
    </application>
</manifest>
