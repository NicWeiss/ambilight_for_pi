# Скопировать в .env и поправить. Всё, чего здесь нет, берётся из settings.py.

# Лента WS2812B: число светодиодов по сторонам (общее число считается само)
LEDS_LEFT=29
LEDS_TOP=51
LEDS_RIGHT=29
LEDS_BOTTOM=0

# Карта захвата (HDMI)
CAPTURE_SOURCE=0

# --- Какие источники включены (каждый можно выключить независимо) -----------------------------
HDMI_ENABLED=true
TV_ENABLED=true

# --- Источник ТВ (см. tv/README.md) -------------------------------------------------------
# MAC Wi-Fi телевизора: по нему ТВ ищется в сети, поэтому смена IP после перезагрузки не страшна.
# Узнать: на ТВ сервисное меню (Factory menu) -> WIFI MAC, либо `ip neigh` на плате после обращения к ТВ.
TV_MAC=6c:22:1a:9e:a0:04

# --- Выбор источника -----------------------------------------------------------------------
# HDMI главнее. Если HDMI чёрный дольше HDMI_HOLD_SECONDS - берём картинку с ТВ.
HDMI_HOLD_SECONDS=8
# Должен быть заметно выше hdmi_peak из /status при отключённом HDMI (при CAPTURE_BRIGHTNESS=40 пустой кадр даёт ~0)
HDMI_PICTURE_THRESHOLD=25
